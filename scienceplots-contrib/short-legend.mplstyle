# Matplotlib style for text-only legends, coloured by line
# Each legend label takes the colour of its line/marker, and the handle
# (the little line/marker sample) is removed entirely — the coloured text
# IS the key. No frame, no eye travel between handle and text.

legend.frameon : False
legend.labelcolor : linecolor
legend.markerscale : 0
legend.handlelength : 0
legend.handletextpad : 0
