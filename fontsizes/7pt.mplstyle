# 7pt.mplstyle — journal, single panel (~7 pt base)
# Font-size-only patch: a proportional type hierarchy (title = 1.2x base,
# ticks/legend = 0.83x base) you stack on any base style to set absolute point
# sizes. Sizes are in points, so they hold at any figsize. Stack AFTER the base:
#   plt.style.use(["paper.mplstyle", "sizes/single.mplstyle", "fontsizes/7pt.mplstyle"])

font.size:             7
axes.titlesize:        8
axes.labelsize:        7
xtick.labelsize:       6
ytick.labelsize:       6
legend.fontsize:       6
legend.title_fontsize: 7
figure.titlesize:      8
figure.labelsize:      7
