# 5pt.mplstyle — journal, dense multi-panel (~5 pt base)
# Font-size-only patch: a proportional type hierarchy (title = 1.2x base,
# ticks/legend = 0.83x base) you stack on any base style to set absolute point
# sizes. Sizes are in points, so they hold at any figsize. Stack AFTER the base:
#   plt.style.use(["paper.mplstyle", "sizes/2x3.mplstyle", "fontsizes/5pt.mplstyle"])

font.size:             5
axes.titlesize:        6
axes.labelsize:        5
xtick.labelsize:       4
ytick.labelsize:       4
legend.fontsize:       4
legend.title_fontsize: 5
figure.titlesize:      6
figure.labelsize:      5
