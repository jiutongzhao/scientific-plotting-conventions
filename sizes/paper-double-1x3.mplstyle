# Size patch — stack AFTER the base style (later entries override earlier ones):
#   plt.style.use(["paper.mplstyle", "sizes/paper-double-1x3.mplstyle"])
# Height rule: height = width x 0.618 (golden) x rows/cols — rows:cols = 1:3
# for a 1x3 panel strip (each panel 2.36 x 1.46 in, golden).
figure.figsize: 7.087, 1.46     # 180 mm double column, third-golden height
